    "# ============================================================\n",
    "# Step 7: Backprojection (используем GT masks как «предсказания» для теста пайплайна)\n",
    "# ============================================================\n",
    "\n",
    "from collections import Counter as PyCounter\n",
    "\n",
    "def backproject_multiview(frames_dir, pix_to_face_pattern, pred_mask_pattern,\n",
    "                           n_frames, n_total_faces, valid_mask=None):\n",
    "    \"\"\"\n",
    "    Мультивью голосование для backprojection предсказаний на 3D меш.\n",
    "\n",
    "    frames_dir:            директория с кадрами\n",
    "    pix_to_face_pattern:   f-string шаблон, например 'pix_to_face_{:04d}.npy'\n",
    "    pred_mask_pattern:     f-string шаблон, 'seg_mask_{:04d}.npy' (GT или pred)\n",
    "    n_frames:              количество кадров\n",
    "    n_total_faces:         число граней в меше\n",
    "    valid_mask:            bool array (которые кадры валидны)\n",
    "    \"\"\"\n",
    "    face_votes = defaultdict(PyCounter)   # face_id → Counter(label → votes)\n",
    "\n",
    "    for i in range(n_frames):\n",
    "        if valid_mask is not None and not valid_mask[i]:\n",
    "            continue\n",
    "\n",
    "        p2f_path  = frames_dir / pix_to_face_pattern.format(i)\n",
    "        pred_path = frames_dir / pred_mask_pattern.format(i)\n",
    "\n",
    "        if not p2f_path.exists() or not pred_path.exists():\n",
    "            continue\n",
    "\n",
    "        p2f  = np.load(str(p2f_path)).flatten()   # (H*W,)\n",
    "        pred = np.load(str(pred_path)).flatten()   # (H*W,)\n",
    "\n",
    "        valid_pix = p2f >= 0\n",
    "        for face_id, label in zip(p2f[valid_pix], pred[valid_pix]):\n",
    "            if label >= 0:\n",
    "                face_votes[int(face_id)][int(label)] += 1\n",
    "\n",
    "    # Финальные метки\n",
    "    final_labels = np.zeros(n_total_faces, dtype=np.int32)  # 0 = background\n",
    "    for face_id, votes in face_votes.items():\n",
    "        final_labels[face_id] = votes.most_common(1)[0][0]\n",
    "\n",
    "    covered = len(face_votes)\n",
    "    print(f\"Backprojection: {covered}/{n_total_faces} ({100*covered/n_total_faces:.1f}%) faces covered\")\n",
    "\n",
    "    return final_labels\n",
    "\n",
    "\n",
    "if HAS_PYTORCH3D and FRAMES_DIR.exists():\n",
    "    # Тест: используем GT seg_mask как «предсказания» → должны получить ~100% accuracy\n",
    "    backproj_labels = backproject_multiview(\n",
    "        frames_dir=FRAMES_DIR,\n",
    "        pix_to_face_pattern='pix_to_face_{:04d}.npy',\n",
    "        pred_mask_pattern='seg_mask_{:04d}.npy',   # GT masks\n",
    "        n_frames=N_VIEWS,\n",
    "        n_total_faces=len(face_labels),\n",
    "        valid_mask=valid_cam_mask\n",
    "    )\n",
    "\n",
    "    # Простая accuracy (для GT masks должна быть близка к 100%)\n",
    "    covered = backproj_labels > 0\n",
    "    match   = backproj_labels[covered] == face_labels[covered]\n",
    "    print(f\"GT backprojection accuracy: {match.mean()*100:.1f}% (on covered faces)\")\n",
    "\n",
    "    np.save(str(OUTPUT_DIR / 'backproj_labels.npy'), backproj_labels)\n",
    "    print(\"✅ Saved backproj_labels.npy\")\n",
    "else:\n",
    "    print(\"Backprojection skipped (no frames available)\")"
   ]
