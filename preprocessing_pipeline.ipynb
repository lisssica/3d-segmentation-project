    "    normals_world_flat = normals_world.reshape(-1, 3)             # (H*W, 3)\n",
    "    normals_cam_flat   = normals_world_flat @ R_np.T              # rotate to cam space\n",
    "    normals_cam        = normals_cam_flat.reshape(img_size, img_size, 3)\n",
    "\n",
    "    # Глубина: нормализуем z-buffer\n",
    "    depth = zbuf.copy()\n",
    "\n",
    "    return normals_world, normals_cam, depth, seg_mask, pix_to_face, R_np, T[0].cpu().numpy()\n",
    "\n",
    "\n",
