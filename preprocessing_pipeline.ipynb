    "# ============================================================\n",
    "# Step 6: Конвертация в формат nnUnet\n",
    "# ============================================================\n",
    "\n",
    "try:\n",
    "    import nibabel as nib\n",
    "    HAS_NIBABEL = True\n",
    "except ImportError:\n",
    "    HAS_NIBABEL = False\n",
    "    print(\"nibabel not available: pip install nibabel\")\n",
    "\n",
    "def save_nifti(arr, path):\n",
    "    \"\"\"Сохраняет numpy array как NIfTI (.nii.gz).\"\"\"\n",
    "    img = nib.Nifti1Image(arr, np.eye(4))\n",
    "    nib.save(img, str(path))\n",
    "\n",
    "\n",
    "def convert_frame_to_nnunet(frame_id, frames_dir, output_dir_nnunet, case_id,\n",
    "                              use_world_normals=True):\n",
    "    \"\"\"\n",
    "    Конвертирует один кадр в формат nnUnet (4 модальности + маска).\n",
    "    use_world_normals: True = world normals, False = camera normals\n",
    "    \"\"\"\n",
    "    if not HAS_NIBABEL:\n",
    "        return\n",
    "\n",
    "    suffix = 'world' if use_world_normals else 'camera'\n",
    "    normals = np.load(str(frames_dir / f'normals_{suffix}_{frame_id}.npy'))  # H,W,3\n",
    "    depth   = np.load(str(frames_dir / f'depth_{frame_id}.npy'))             # H,W\n",
    "    seg     = np.load(str(frames_dir / f'seg_mask_{frame_id}.npy'))          # H,W\n",
    "\n",
    "    # Нормализуем нормали в [0,1]\n",
    "    normals_01 = (normals + 1) / 2\n",
    "    # Нормализуем глубину\n",
    "    d_min, d_max = depth[depth > 0].min(), depth.max() + 1e-6\n",
    "    depth_01 = np.where(depth > 0, (depth - d_min) / (d_max - d_min), 0.0)\n",
    "\n",
    "    images_dir = output_dir_nnunet / 'imagesTr'\n",
    "    labels_dir = output_dir_nnunet / 'labelsTr'\n",
