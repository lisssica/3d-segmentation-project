    "# ============================================================\n",
    "# Step 4: Проверка позиций камер\n",
    "# ============================================================\n",
    "\n",
    "# Строим словарь instance_mesh: label -> Trimesh (трансформированный)\n",
    "print(\"Building per-instance meshes for camera validation...\")\n",
    "instance_meshes = {}\n",
    "for inst in instances:\n",
    "    m = inst['mesh'].copy()\n",
    "    m.apply_transform(inst['transform'])\n",
    "    instance_meshes[inst['label']] = m\n",
    "\n",
    "def is_camera_inside_any_mesh(cam_pos, instance_meshes, eps=1e-3):\n",
    "    \"\"\"Проверяет, находится ли cam_pos внутри любого instance меша.\"\"\"\n",
    "    pt = np.array([cam_pos])\n",
    "    for label, mesh in instance_meshes.items():\n",
    "        try:\n",
    "            if mesh.contains(pt)[0]:  # trimesh.contains_points\n",
    "                return True, label\n",
    "        except Exception:\n",
    "            pass\n",
    "    return False, None\n",
    "\n",
    "valid_cam_mask = np.ones(N_VIEWS, dtype=bool)\n",
    "inside_count   = 0\n",
    "\n",
    "for i, cam_pos in enumerate(camera_positions):\n",
    "    inside, which_label = is_camera_inside_any_mesh(cam_pos, instance_meshes)\n",
    "    if inside:\n",
    "        valid_cam_mask[i] = False\n",
    "        inside_count += 1\n",
    "        if inside_count <= 5:\n",
    "            print(f\"  Frame {i}: camera INSIDE label={which_label}\")\n",
    "\n",
    "print(f\"\\nCamera validation: {inside_count}/{N_VIEWS} cameras inside mesh → filtered\")\n",
    "print(f\"Valid cameras: {valid_cam_mask.sum()}/{N_VIEWS} ({100*valid_cam_mask.mean():.1f}%)\")\n",
