    "    normals_world   = np.zeros((img_size, img_size, 3), dtype=np.float32)\n",
    "    normals_world[valid] = face_normals_np[pix_to_face[valid]]\n",
    "\n",
    "    # Нормали в camera space: применяем матрицу вращения R\n",
