    "# ============================================================\n",
    "\n",
    "def render_frame_pytorch3d(cam_pos, target, mesh_verts_t, mesh_faces_t, face_labels_t,\n",
    "                           img_size=IMG_SIZE, fov=FOV_DEG, device=None):\n",
    "    \"\"\"\n",
    "    Рендерит один кадр. Возвращает (normals_world, normals_cam, depth, seg_mask, pix_to_face, R, T).\n",
    "    \n",
    "    cam_pos:  (3,) numpy array — позиция камеры в мировых координатах\n",
    "    target:   (3,) numpy array — точка фокусировки (центр объекта)\n",
    "    \"\"\"\n",
    "    if device is None:\n",
    "        device = torch.device('cpu')\n",
    "\n",
    "    # Матрица вида camera\n",
    "    cam_pos_t  = torch.tensor(cam_pos[None], dtype=torch.float32)\n",
    "    target_t   = torch.tensor(target[None],  dtype=torch.float32)\n",
    "    up         = torch.tensor([[0., 1., 0.]])\n",
    "\n",
    "    R, T = look_at_view_transform(eye=cam_pos_t, at=target_t, up=up)\n",
    "\n",
    "    cameras = FoVPerspectiveCameras(R=R, T=T, fov=fov, device=device)\n",
    "\n",
    "    raster_settings = RasterizationSettings(\n",
    "        image_size=img_size,\n",
    "        blur_radius=0.0,\n",
    "        faces_per_pixel=1,     # 1 грань на пиксель (ближняя)\n",
    "    )\n",
    "    rasterizer = MeshRasterizer(cameras=cameras, raster_settings=raster_settings)\n",
    "\n",
    "    mesh = Meshes(verts=[mesh_verts_t.to(device)], faces=[mesh_faces_t.to(device)])\n",
    "    fragments = rasterizer(mesh)\n",
    "\n",
    "    pix_to_face = fragments.pix_to_face[0, :, :, 0].cpu().numpy()   # (H, W) int64\n",
    "    zbuf        = fragments.zbuf[0, :, :, 0].cpu().numpy()           # (H, W) float32\n",
    "\n",
    "    # Маска сегментации: -1 = фон\n",
    "    seg_mask = np.full((img_size, img_size), -1, dtype=np.int32)\n",
    "    valid    = pix_to_face >= 0\n",
